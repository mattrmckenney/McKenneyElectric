---
import Logo from "./Logo.astro";

const links = [
  { href: "#services", label: "Services" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b-4 border-ink bg-volt">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="#top" class="text-ink" aria-label="McKenney Electric Co home">
      <Logo variant="compact" />
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      <ul class="flex items-center gap-6 font-body text-sm font-medium tracking-wide uppercase">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-ink/60">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="tel:7044869228"
        class="font-body text-sm font-semibold tracking-wide whitespace-nowrap"
      >
        704.486.9228
      </a>
      <a
        href="#contact"
        class="rounded-sm border-2 border-ink bg-ink px-4 py-2 font-body text-sm font-semibold tracking-wide text-volt uppercase transition-colors hover:bg-ink-soft"
      >
        Free Estimate
      </a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="flex flex-col gap-1.5 p-2 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="h-0.5 w-7 bg-ink"></span>
      <span class="h-0.5 w-7 bg-ink"></span>
      <span class="h-0.5 w-7 bg-ink"></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t-4 border-ink bg-volt px-4 pb-6 md:hidden"
  >
    <ul class="flex flex-col gap-4 pt-4 font-body text-lg font-medium tracking-wide uppercase">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="menu-link block">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="tel:7044869228" class="menu-link block font-semibold">
          704.486.9228
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  document.querySelectorAll(".menu-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
