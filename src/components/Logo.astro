---
import Bolt from "./Bolt.astro";

interface Props {
  variant?: "stacked" | "compact";
  class?: string;
}
const { variant = "stacked", class: className = "" } = Astro.props;
---

{
  variant === "stacked" ? (
    <div class={`inline-flex flex-col leading-none ${className}`}>
      <span class="font-display uppercase tracking-tight text-[clamp(2.2rem,6vw,4.5rem)]">
        McKenney
      </span>
      <span class="-mt-2 flex items-center gap-2 pl-2 sm:pl-3">
        <Bolt class="h-6 w-4 shrink-0 sm:h-8 sm:w-5" />
        <span class="font-script text-[clamp(1.6rem,4.5vw,3rem)]">
          Electric Co
        </span>
      </span>
    </div>
  ) : (
    <div class={`inline-flex items-center gap-2 leading-none ${className}`}>
      <Bolt class="h-6 w-4 shrink-0" />
      <span class="flex flex-col">
        <span class="font-display uppercase tracking-tight text-xl sm:text-2xl">
          McKenney
        </span>
        <span class="font-script -mt-1 text-base sm:text-lg">
          Electric Co
        </span>
      </span>
    </div>
  )
}
