---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<!-- Bottom padding lets footer content scroll clear of the fixed chat widget. -->
<footer class="border-t-4 border-volt bg-ink pt-10 pb-48 text-cream md:pb-40">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 text-center sm:px-6 md:flex-row md:justify-between md:text-left">
    <a href="/#top" aria-label="McKenney Electric Co home">
      <Logo variant="compact" class="text-cream" />
    </a>

    <p class="font-body text-sm tracking-wide text-cream/60 uppercase">
      Quality Work and Affordable Prices
    </p>

    <div class="flex flex-col items-center gap-2 md:items-end md:text-right">
      <p class="flex items-center gap-2 font-body text-sm font-semibold tracking-wide text-cream uppercase">
        <svg
          viewBox="0 0 6 6"
          preserveAspectRatio="none"
          aria-hidden="true"
          class="h-4 w-6 shrink-0 rounded-[2px]"
        >
          <rect width="6" height="1" y="0" fill="#E40303" />
          <rect width="6" height="1" y="1" fill="#FF8C00" />
          <rect width="6" height="1" y="2" fill="#FFED00" />
          <rect width="6" height="1" y="3" fill="#008026" />
          <rect width="6" height="1" y="4" fill="#004DFF" />
          <rect width="6" height="1" y="5" fill="#750787" />
        </svg>
        Proudly Gay Owned
      </p>
      <p class="font-body text-sm text-cream/60">
        &copy; {year} McKenney Electric Co. &bull; Charlotte &amp; Surrounding Areas
      </p>
      <p class="font-body text-sm text-cream/60">
        NC Electrical License L.30467
      </p>
      <p class="font-body text-xs text-cream/50">
        Website built by humans, with AI
      </p>
    </div>
  </div>

  <div class="mx-auto mt-8 max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col items-center gap-3 border-t border-cream/20 pt-8 sm:flex-row sm:justify-center sm:gap-5">
      <p class="font-body text-sm font-semibold tracking-[0.3em] text-volt uppercase">
        Follow Us
      </p>
      <a
        href="https://www.facebook.com/mckenneyelectriccompany"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-sm border-2 border-volt px-4 py-2 font-body text-sm font-semibold tracking-wide text-volt uppercase transition-colors hover:bg-volt hover:text-ink"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4 w-4 shrink-0">
          <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.03 4.39 11.03 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z" />
        </svg>
        Facebook
      </a>
    </div>
    <p class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 font-body text-sm text-cream/60">
      <a href="/privacy-policy/" class="underline hover:text-volt">Privacy Policy</a>
      <a href="/terms-and-conditions/" class="underline hover:text-volt">Terms &amp; Conditions</a>
    </p>
  </div>
</footer>
