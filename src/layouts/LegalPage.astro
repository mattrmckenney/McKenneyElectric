---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} | McKenney Electric Co`} description={description}>
  <Nav />
  <main class="bg-cream py-14 sm:py-20">
    <article class="legal mx-auto max-w-3xl px-4 font-body text-lg sm:px-6">
      <h1 class="font-display text-4xl uppercase sm:text-5xl">{title}</h1>
      <p class="mt-3 text-base font-semibold tracking-wide text-ink/60 uppercase">
        Last updated {updated}
      </p>
      <slot />
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .legal h2 {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .legal p,
  .legal ul {
    margin-top: 0.875rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .legal li + li {
    margin-top: 0.375rem;
  }
  .legal article a,
  .legal a {
    font-weight: 600;
    text-decoration: underline;
  }
</style>
